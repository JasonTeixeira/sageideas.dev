{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "node scripts/serve-prod.mjs",
      "startServerReadyPattern": "ready - serving Next.js",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/services",
        "http://127.0.0.1:4173/work",
        "http://127.0.0.1:4173/pricing",
        "http://127.0.0.1:4173/blog",
        "http://127.0.0.1:4173/contact"
      ],
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "throttlingMethod": "provided"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.88 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
