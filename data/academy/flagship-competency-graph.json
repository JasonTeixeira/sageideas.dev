{
  "schemaVersion": 1,
  "pathId": "flagship-production-ai-automation-engineer-v1",
  "title": "Production AI, Automation, Cloud, and Network Engineering",
  "status": "draft",
  "levels": [
    {
      "id": "novice",
      "label": "Novice",
      "outcome": "Can follow a model with support and name what remains unclear."
    },
    {
      "id": "foundation",
      "label": "Foundation",
      "outcome": "Can complete bounded tasks, explain the mechanism, and diagnose common failures."
    },
    {
      "id": "practitioner",
      "label": "Practitioner",
      "outcome": "Can build and operate a complete system under explicit constraints."
    },
    {
      "id": "advanced",
      "label": "Advanced",
      "outcome": "Can make defensible tradeoffs, handle unfamiliar failures, and improve system quality."
    },
    {
      "id": "mastery",
      "label": "Mastery",
      "outcome": "Can integrate disciplines, defend decisions with evidence, teach the model, and transfer it to a novel production problem."
    }
  ],
  "masteryPolicy": {
    "requiredEvidence": [
      {
        "type": "build",
        "contract": "Produce a working artifact from a blank or deliberately incomplete starting point without copying the reference solution."
      },
      {
        "type": "debug",
        "contract": "Diagnose and repair an injected or naturally occurring failure, including the causal explanation and regression test."
      },
      {
        "type": "explain",
        "contract": "Teach the mechanism and defend the important tradeoff in plain language without relying on memorized wording."
      },
      {
        "type": "transfer",
        "contract": "Apply the skill to a materially different, previously unseen scenario."
      },
      {
        "type": "retrieve",
        "contract": "Reproduce the key model after delay and repair any confidence-versus-performance mismatch."
      }
    ],
    "retrievalScheduleDays": [
      2,
      7,
      21,
      45
    ],
    "minimumKnowledgeScore": 0.85,
    "minimumIndependentAttempts": 2,
    "labEvidenceBeforeTrustedRuntime": "practice_only",
    "outcomeDisclaimer": "Completion does not guarantee employment, expertise in every context, or a top-one-percent percentile outcome; the path defines demanding observable evidence for production readiness and continued mastery practice."
  },
