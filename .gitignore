# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Supabase CLI local project state
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local audit repos and embedded samples
_repo-audits/
public/projects/

# Lighthouse CI outputs (reports generated locally/CI)
.lighthouseci/

# Playwright artifacts / local test outputs
test-results/
playwright-report/
.design-review/

# Terraform runtime artifacts (NEVER commit)
**/.terraform/
**/.terraform.lock.hcl.backup
**/terraform.tfstate
**/terraform.tfstate.*
**/terraform.tfvars
!**/terraform.tfvars.example

# Built artifacts (keep source, not bundles)
infra/**/dist/
.env*.local

# Academy build-your-own-path route/component are SOURCE, not build output.
# Override the global gitignore `build/` rule that was swallowing them.
!app/academy/build/
!components/academy/build/
design-source/sage-academy/

# voice engine — private reference + generated narration (regenerable, not in git)
.voice-work/
public/academy/voice/

# generated quality scorecards
proof-artifacts/
content-studio/brand-board.html
content-studio/thumbnail-board.html
content-studio/renders/thumbs/
content-studio/renders/tb-qc-*.png
content-studio/styles-board.html
content-studio/renders/thumbs2/
content-studio/hybrid-board.html
content-studio/renders/hybrids/
content-studio/compare-board.html
content-studio/renders/compare/
content-studio/dark-board.html
content-studio/darkhf-board.html
content-studio/renders/darkhf/
content-studio/renders/prod/
content-studio/renders/vo/
content-studio/video-artifact.html
content-studio/voicetest.html
content-studio/renders/voicetest/
content-studio/renders/vid-frame-*.png
content-studio/ds-showcase.html
content-studio/renders/ds-*.png
content-studio/renders/scenes-proof.png

content-studio/node_modules/
content-studio/renders/*-proof.png
